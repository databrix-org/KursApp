# LOCAL DEVELOPMENT ONLY. Copy to .env; never commit real credentials.
DATABRIX_ENV=development
DJANGO_SECRET_KEY=local-development-key-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
PUBLIC_ORIGIN=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000
POSTGRES_PASSWORD=local-database-password
S3_ACCESS_KEY_ID=local-databrix
S3_SECRET_ACCESS_KEY=local-storage-password
S3_REGION=eu-central-1
S3_BUCKET_COURSE=databrix-course
S3_BUCKET_NOTEBOOKS=databrix-notebooks
S3_BUCKET_ASSESSMENT=databrix-assessment
S3_BUCKET_SUPPORT=databrix-support
SSO_ENABLED=false
NOTEBOOK_ALLOWED_HOSTS=
LEGACY_UI_ENABLED=true
DEMO_PASSWORD=Local-Demo-Password-449!
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.invalid
SUPPORT_EMAIL=support@example.invalid
